<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.example.university_timetable" />
        <package android:name="com.example.university_timetable.debug" />
        <!-- Feedback channel deep links (Coolapk / Xiaohongshu / QQ / WeChat) -->
        <package android:name="com.coolapk.market" />
        <package android:name="com.xingin.xhs" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.tencent.mm" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="coolmarket" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="xhsdiscover" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mqqopensdkapi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mqqapi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="weixin" />
        </intent>
        <!-- 系统闹钟（这节课闹钟）：包可见性探测 -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- 这节课闹钟静默写入（EXTRA_SKIP_UI）所需权限，确认页模式可不依赖 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Course reminders are core alarm-clock-like behavior. On Android 13+ this
         is granted automatically and makes canScheduleExactAlarms() true. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>

    <!-- 天气「使用当前位置」。
         COARSE 必须与 FINE 同时声明：Android 12+ 只声明 FINE 会直接 lint 失败，
         且两者同在时系统才会弹「精确 / 大致」二选一；用户选「大致」时功能照常，
         天气本来就按区级算。只在用户点「使用当前位置」时才申请，不随启动索取。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <application
        android:name=".QhkbApplication"
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="false">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Debug / profile automation deep links (adb / Android CLI). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="qhkb-debug" />
                <!-- 读取兼容：更名前旧版深链 scheme，既有的 adb / CLI 脚本继续可用 -->
                <data android:scheme="mikcb-debug" />
            </intent-filter>

            <!-- Supported import types: .ics, .qhkb, .json, .csv, .xlsx
                 （.mikcb 为更名前旧版备份扩展名，读取端一并接受） -->

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/comma-separated-values" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/comma-separated-values" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>

            <!-- Mi Share and file managers often label unknown extensions as octet-stream -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.ics" android:pathSuffix=".ics" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.ics" android:pathSuffix=".ics" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.qhkb" android:pathSuffix=".qhkb" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.qhkb" android:pathSuffix=".qhkb" />
                <!-- 读取兼容：更名前旧版备份扩展名（读取端接受，写出仍为 .qhkb） -->
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.mikcb" android:pathSuffix=".mikcb" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.mikcb" android:pathSuffix=".mikcb" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.json" android:pathSuffix=".json" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.json" android:pathSuffix=".json" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.csv" android:pathSuffix=".csv" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.csv" android:pathSuffix=".csv" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.xlsx" android:pathSuffix=".xlsx" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.xlsx" android:pathSuffix=".xlsx" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
        <service
            android:name=".LiveUpdateService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Course live activity and schedule reminders while class is in progress" />
        </service>

        <!-- System broadcasts need exported=true; custom ACTION_TRIGGER is only
             delivered via explicit Component PendingIntent (not in filter). -->
        <receiver
            android:name=".LiveUpdateReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- Explicit PendingIntent delivers ACTION_FIRE; boot/time filters re-arm. -->
        <receiver
            android:name=".ExamReminderReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- Weekly report: explicit PendingIntent delivers ACTION_FIRE; boot/time filters re-arm. -->
        <receiver
            android:name=".WeeklyReportReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TodayMiniListWidgetProvider"
            android:label="@string/widget_today_mini_list_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_mini_list_info" />
        </receiver>

        <receiver
            android:name=".TodayLargeWidgetProvider"
            android:label="@string/widget_today_large_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_large_info" />
        </receiver>

        <receiver
            android:name=".TodayStripWidgetProvider"
            android:label="@string/widget_today_strip_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_strip_info" />
        </receiver>

        <receiver
            android:name=".TodayCourse42WidgetProvider"
            android:label="@string/widget_today_course_42_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_course_42_info" />
        </receiver>

        <receiver
            android:name=".ExamCountdownWidgetProvider"
            android:label="@string/widget_exam_card_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_exam_card_info" />
        </receiver>

        <receiver
            android:name=".CoupleTimetableWidgetProvider"
            android:label="@string/widget_couple_timetable_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_couple_timetable_info" />
        </receiver>

        <receiver
            android:name=".CoupleTimetableWideWidgetProvider"
            android:label="@string/widget_couple_timetable_wide_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_couple_timetable_wide_info" />
        </receiver>

        <service
            android:name=".CoupleTimetableViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="true" />

        <receiver
            android:name=".HomeWidgetRefreshReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
            
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Live backdrop blur requires Impeller. See .trellis/spec/flutter/hyperos-blurred-header.md.
             Set false to restore v1.1.5-a Vulkan crash workaround (tint-only headers). -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="true" />
    </application>
</manifest>
