<?xml version="1.0" encoding="utf-8"?>
<!-- 今日课程迷你列表 2×2：对齐 demo 的情侣卡片迷你版
     （160×186dp、18dp 圆角白卡、10dp/7dp 内边距、3 条课程行 + 底部「还有 N 节」）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mini_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_mini_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_demo_card_bg"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="7dp"
        android:paddingRight="10dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:id="@+id/widget_mini_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_mini_heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="接下来"
                android:textColor="@color/widget_couple_text_hint"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/widget_mini_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="第6周"
                android:textColor="@color/widget_couple_text_hint"
                android:textSize="8.5sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/widget_mini_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/widget_mini_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp">

                    <ImageView
                        android:id="@+id/widget_mini_row_1_bar"
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_couple_indicator" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/widget_mini_row_1_name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="none"
                                android:maxLines="1"
                                android:text="高等数学"
                                android:textColor="@color/widget_couple_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/widget_mini_row_1_weather_icon"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginStart="2dp"
                                android:contentDescription="@null"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/widget_mini_row_1_weather_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="1dp"
                                android:maxLines="1"
                                android:text="23°"
                                android:textColor="@color/widget_couple_text_secondary"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp">

                            <TextView
                                android:id="@+id/widget_mini_row_1_location"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentLeft="true"
                                android:layout_centerVertical="true"
                                android:layout_toLeftOf="@+id/widget_mini_row_1_time"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="高博学楼327"
                                android:textColor="@color/widget_couple_text_secondary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/widget_mini_row_1_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="5dp"
                                android:maxLines="1"
                                android:text="08:00 - 09:40"
                                android:textColor="@color/widget_couple_text_secondary"
                                android:textSize="10sp" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_mini_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp">

                    <ImageView
                        android:id="@+id/widget_mini_row_2_bar"
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_couple_indicator" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/widget_mini_row_2_name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="none"
                                android:maxLines="1"
                                android:text="大学英语"
                                android:textColor="@color/widget_couple_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/widget_mini_row_2_weather_icon"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginStart="2dp"
                                android:contentDescription="@null"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/widget_mini_row_2_weather_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="1dp"
                                android:maxLines="1"
                                android:text="23°"
                                android:textColor="@color/widget_couple_text_secondary"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp">

                            <TextView
                                android:id="@+id/widget_mini_row_2_location"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentLeft="true"
                                android:layout_centerVertical="true"
                                android:layout_toLeftOf="@+id/widget_mini_row_2_time"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="一教C104"
                                android:textColor="@color/widget_couple_text_secondary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/widget_mini_row_2_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="5dp"
                                android:maxLines="1"
                                android:text="10:10 - 11:50"
                                android:textColor="@color/widget_couple_text_secondary"
                                android:textSize="10sp" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_mini_row_3"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp">

                    <ImageView
                        android:id="@+id/widget_mini_row_3_bar"
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_couple_indicator" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/widget_mini_row_3_name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="none"
                                android:maxLines="1"
                                android:text="程序设计"
                                android:textColor="@color/widget_couple_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/widget_mini_row_3_weather_icon"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginStart="2dp"
                                android:contentDescription="@null"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/widget_mini_row_3_weather_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="1dp"
                                android:maxLines="1"
                                android:text="23°"
                                android:textColor="@color/widget_couple_text_secondary"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp">

                            <TextView
                                android:id="@+id/widget_mini_row_3_location"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentLeft="true"
                                android:layout_centerVertical="true"
                                android:layout_toLeftOf="@+id/widget_mini_row_3_time"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="二教B203"
                                android:textColor="@color/widget_couple_text_secondary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/widget_mini_row_3_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="5dp"
                                android:maxLines="1"
                                android:text="13:30 - 15:10"
                                android:textColor="@color/widget_couple_text_secondary"
                                android:textSize="10sp" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_mini_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:maxLines="2"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="🍵 今天没有课程"
                android:textColor="@color/widget_couple_text_hint"
                android:textSize="13.5sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_mini_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="还有 2 节"
            android:textColor="@color/widget_couple_text_secondary"
            android:textSize="8.5sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
